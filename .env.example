# Primary application database
DATABASE_URL=

# Google Calendar OAuth web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the authorized redirect URI in Google Cloud.
# Production example: https://your-domain.example/api/google-calendar/callback
# Local example: http://localhost:3000/api/google-calendar/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/google-calendar/callback

# Long random secret used to encrypt Google refresh/access tokens before storage.
# Generate with: openssl rand -base64 32
GOOGLE_CALENDAR_TOKEN_KEY=
